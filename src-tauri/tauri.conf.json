{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Context",
  "version": "0.1.2",
  "identifier": "dev.gitcontext.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Context",
        "width": 1240,
        "height": 850,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Git Context",
    "homepage": "https://github.com/PandyaPreet/GitContext",
    "category": "DeveloperTool",
    "shortDescription": "A local developer identity control center",
    "longDescription": "Switch between GitHub and GitLab identities per repository. Git Context manages Git author details, SSH keys and SSH host aliases locally, previews every change and lets you undo it.",
    "copyright": "Copyright \u00a9 2026 Git Context contributors",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "release": "1"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/PandyaPreet/GitContext/releases/latest/download/latest.json"
      ]
    }
  }
}
